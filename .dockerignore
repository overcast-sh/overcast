# Ignore everything, then allowlist only what the build needs.
*

# ---- Go builder (stage 2) ---------------------------------------------------
# Nothing is generated during the image build: the console derives the docs
# navigation and search index from the embedded docs at runtime, so the build
# context needs no generator and no Go toolchain in the web stage.
!go.mod
!go.sum
!embed.go
!embed_slim.go
!cmd/
!internal/
# The Lambda init is built inside the builder stage (both Linux architectures,
# whatever the image's own platform), so a host-built copy is dead weight and
# could be stale. The committed dist/.gitkeep still arrives with !internal/,
# which is what the embed pattern needs.
internal/services/lambda/initbin/dist/lambda-init-linux-*
# Likewise the packed aws-sdk shape tables: the image packs its own from the
# committed text (Dockerfile), never a host copy that might be stale.
internal/awsshapes/dist/*.gz
!docs/
!docs/*.md
!docs/cdk/
!docs/cdk/**
!docs/services/
!docs/services/**

# ---- Web builder (stage 1) --------------------------------------------------
!web/
# pnpm install runs inside the container — host node_modules are dead weight (~800 MB).
web/node_modules/
# Build outputs that may exist locally.
web/dist/

# ---- Console stage (stage 5) ------------------------------------------------
!docker/
