# Normalize line endings to LF in the repository regardless of which OS
# checks a file out. This keeps `git status` clean whether you're on native
# Windows, macOS, Linux, or the dev container.
* text=auto eol=lf

# Shell scripts must always have LF endings so the shebang works on every OS.
scripts/*.sh text eol=lf
scripts/verify-changed.sh text eol=lf working-tree-encoding=UTF-8
scripts/*.ps1 text eol=crlf

# Committed generated files. linguist-generated collapses them by default in
# GitHub review and keeps them out of language stats, while leaving `git diff`
# fully textual — deliberately not `-diff`, which would hide the content from
# review and reduce a staleness failure to "binary files differ". Never
# hand-merge these: resolve any conflict by re-running `make generate-caps` /
# `make generate-ts`.
#
# The docs navigation and search index used to be here too. They are not
# generated into the repository any more — the console derives both from the
# docs the binary embeds, at runtime — because a sorted one-entry-per-page
# manifest conflicts whenever one branch adds a page and another edits its
# neighbour, and a merge driver cannot help: GitHub computes mergeability
# server-side and does not run custom drivers. See internal/docsindex.
web/src/types/api.gen.ts linguist-generated=true
internal/capabilities/all.gen.go linguist-generated=true
internal/awsshapes/*.gen.go linguist-generated=true
web/src/routeTree.gen.ts linguist-generated=true
internal/services/dynamodb/reserved_words.txt linguist-generated=true
compat/model/scenarios/*.json linguist-generated=true
compat/model/gaps.json linguist-generated=true
compat/suites/registry.generated.json linguist-generated=true
compat/suites/go-sdk/internal/groups/scenarios_gen.go linguist-generated=true
compat/suites/go-sdk/internal/groups/scenarios_*_gen.go linguist-generated=true
compat/suites/dotnet-sdk/Groups/Scenarios*Gen.cs linguist-generated=true

# The public installers (install/README.md). install.sh must stay LF: a CRLF
# copy from a Windows checkout is a script sh cannot run. install.ps1 follows
# the scripts/ convention for PowerShell.
install/*.sh text eol=lf
install/*.ps1 text eol=crlf
