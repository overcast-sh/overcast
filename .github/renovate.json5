// Dependency automation, run by the hosted Renovate GitHub App (#561).
//
// This replaces .github/dependabot.yml, and widens its scope: Dependabot
// watched only the root Dockerfile's base-image digests, and could not express
// the one constraint that mattered for Node — stay on LTS. It understands
// semver, not release schedules, so it proposed node 22 → 26 roughly six
// months before Node 26 reaches LTS (#500, then #1168 again). Renovate's
// `node` versioning scheme treats a major as unstable until its release line
// reaches LTS, and unstable versions are ignored by default — so a
// Current-only major produces no PR, and the LTS rollover arrives as an
// explicit major-version PR that can be held or taken deliberately.
//
// The shape of the policy, everywhere it applies:
//   - Majors are never grouped and never automerged: a breaking change is a
//     decision, and it arrives as its own PR with the major visible in the
//     diff. (#500 grouped three unrelated base bumps into one PR; that
//     grouping is what this repo is NOT doing for version updates.)
//   - Non-major updates are grouped per ecosystem to keep review cheap and CI
//     runs few.
//   - Automerge only where green CI is a sufficient reviewer: digest
//     advances, the Go toolchain, and non-major Go deps. Web deps and action
//     bumps wait for a human glance — a visual regression passes typecheck.
//   - Nothing younger than seven days is taken (`minimumReleaseAge`): a
//     yanked tag or a compromised npm release is usually caught within days
//     of publish, and this repo is content to be a week behind.
//   - Open PRs are kept rebased on `main` rather than only when they
//     conflict. A regenerated lockfile is only true of the base it was
//     generated against, and git will merge two of them without complaint
//     (#1340).
//   - The dependency dashboard issue (on by way of config:recommended) lists
//     everything pending or deliberately not taken, so "no PR" is visible
//     rather than silent.
//
// The Dockerfile pins its bases by digest so a release is reproducible and so
// CI can pull through a registry mirror without that changing what ships. A
// digest pin that nobody advances is worse than no pin at all — it silently
// freezes out base-image security updates. Renovate maintains the existing
// pins (`pinDigests` is deliberately not enabled: the pins exist, and nothing
// unpinned should gain a pin as a side effect).
//
// One package rule has already come and gone: a `typescript` hold at `<7`,
// because @typescript-eslint/typescript-estree crashed at module load under the
// native compiler and took `pnpm run lint` with it. #1330 step 3 removed ESLint
// from web/ altogether, so nothing in the repo loads typescript-estree any more
// and TypeScript 7 went in unheld. If a package rule here ever exists to work
// around one tool, delete it when that tool goes — not later.
//
// The compat suites are excluded deliberately, as they were under Dependabot.
// They are test harnesses: their Dockerfiles, go.mod files and package.json
// files exist to observe the emulator with particular SDK versions, and
// advancing those versions changes what the suite measures — a decision for a
// compat review, not a bot.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Every action is SHA-pinned today (124 of 124). This is the guard for the
    // future: an action added by tag gets a PR converting it to a digest pin.
    'helpers:pinGitHubActionDigests',
  ],

  // An allowlist, because it is the fence that held in the dry run:
  // ignorePaths alone still let the nuget manager pick up a compat suite's
  // .csproj. These four cover every surface that ships or gates a release —
  // the image bases, the Go module, the web workspace, and the workflows.
  enabledManagers: ['dockerfile', 'gomod', 'npm', 'github-actions', 'nodenv', 'custom.regex'],
  // Setting ignorePaths replaces the preset's list, so node_modules comes
  // along. tests/ holds repro fixtures (a pinned package.json is the repro);
  // .devcontainer is a dev environment, not a shipped artifact.
  ignorePaths: ['**/node_modules/**', 'compat/**', 'tests/**', '.devcontainer/**'],

  semanticCommits: 'enabled',

  minimumReleaseAge: '7 days',
  // Left at Renovate's default of timestamp-required on purpose: a release
  // whose age cannot be established counts as too new, not as old enough,
  // so the floor is never quietly skipped. Known consequence: an
  // unauthenticated run gets a 403 from Docker Hub past page 10 of a tag
  // listing, which drops timestamps for tag-heavy images (`golang`, `node`)
  // and parks their version bumps in the dependency dashboard's "pending"
  // list until ticked. If that shows up under the App, the fix is Docker
  // Hub credentials via hostRules, not loosening the behaviour. Digest
  // advances (rebuilds of the same tag, which is how base-image CVE fixes
  // arrive) are not age-gated and flow on the weekly schedule.

  // Vulnerability fixes come from two sources and bypass the schedule, the
  // grouping and the age floor (a fix is wanted on day zero). OSV needs no
  // GitHub feature; `vulnerabilityAlerts` additionally reads GitHub's
  // Dependabot *alerts* (a repo security setting, separate from the retired
  // dependabot.yml) when they are enabled and the App can read them.
  osvVulnerabilityAlerts: true,

  // Weekly, matching the cadence dependabot.yml had. The dashboard still
  // updates between runs, and a security advisory bypasses the schedule.
  schedule: ['* 0-8 * * 1'],

  // Keep every open Renovate PR rebased onto the current `main`, rather than
  // only once it conflicts.
  //
  // Not a no-op on top of the default. `auto` already resolves to
  // `behind-base-branch` for anything carrying `automerge: true` — Renovate
  // declines to automerge a stale branch — so the digest, Go-toolchain and
  // Go-dependency groups were being rebased already. Everything else, which
  // is every group that waits for a human, sat on `conflicted`: rebased when
  // git says the text collides, and not otherwise. That is the set the
  // 2026-08-22 breakage came out of.
  //
  // `web/pnpm-lock.yaml` is one generated file whose peer-resolution keys
  // cross-reference each other — an entry is literally named
  // `vitest@4.1.5(jsdom@27.4.0)(vite@8.0.16(…))(…)`. Two copies of it
  // regenerated independently cannot be combined by merging their text, even
  // though git reports no conflict, because the keys one side wrote name
  // versions the other side changed. Five npm majors merged back to back that
  // day, each reviewed on its own and each carrying its own regenerated lock,
  // and left `main` with a lockfile still naming the pre-bump jsdom: every
  // pull request failed `pnpm install --frozen-lockfile` for 28 minutes,
  // until the next web-deps PR happened to regenerate the lock against all
  // five at once (#1340).
  //
  // Rebasing regenerates the lock against what actually landed, so a pull
  // request is consistent with `main` as of its last rebase rather than as of
  // the day it was opened. Rebases run outside the weekly window
  // (`updateNotScheduled` is left at its default of true), which is the point
  // — a branch that goes stale on Wednesday is regenerated on Wednesday, not
  // next Monday.
  //
  // It does not close the race on its own: `main` can still move between the
  // last rebase and the merge. What closes it is requiring branches to be up
  // to date before merging, which is a branch-protection setting and not
  // anything this file can express.
  rebaseWhen: 'behind-base-branch',

  // A monthly full regeneration of `web/pnpm-lock.yaml`. A direct-dependency
  // bump only re-resolves the part of the tree it touches, so a transitive
  // pin that no direct bump ever reaches sits frozen indefinitely; this is
  // the only thing here that advances it. Monthly rather than weekly because
  // the diff is large and unreadable either way, and `osvVulnerabilityAlerts`
  // above already handles the transitive versions that are known to matter —
  // this is for the residue, not for security response.
  //
  // Deliberately npm-only; the packageRule below turns it off for `gomod`. A
  // lockFileMaintenance run there is `go get -u ./...`, which would bump every
  // indirect module at once and outside the `go dependencies (non-major)`
  // group that exists to review exactly that. go.sum needs no equivalent:
  // `postUpdateOptions: gomodTidy` keeps it in step on every Go update.
  lockFileMaintenance: {
    enabled: true,
    schedule: ['* 0-8 1 * *'],
  },

  postUpdateOptions: ['gomodTidy'],

  // The Makefile pins the Go-run tools (golangci-lint, actionlint) in
  // *_VERSION variables, each preceded by a `# renovate:` line naming the
  // datasource and package. Nothing built-in reads a Makefile, so this is
  // what keeps those pins from rotting — golangci-lint sat on v2.8.0 for
  // want of anything watching it.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^Makefile$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION\\s*:=\\s*(?<currentValue>\\S+)',
      ],
    },
    {
      // Athena's engine image default, config.DefaultAthenaEngineImage: a Go
      // constant, which no built-in manager reads. It is pinned as
      // name:tag@digest, so a republished tag arrives as a digest update and
      // a new Trino release as a version update. `\\s*` around the `=`,
      // because gofmt aligns it if the constant ever joins a const block.
      customType: 'regex',
      managerFilePatterns: ['/^internal/config/config\\.go$/'],
      matchStrings: [
        'DefaultAthenaEngineImage\\s*=\\s*"(?<depName>[^":@]+):(?<currentValue>[^"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"',
      ],
      datasourceTemplate: 'docker',
    },
  ],

  packageRules: [
    {
      // Match the repo's conventional-commit style. This has to be a
      // packageRule, not a top-level setting: config:recommended carries
      // :semanticPrefixFixDepsChoreOthers, whose own packageRules set the
      // type to fix/chore and outrank anything top-level — the first
      // dashboard (#1180) showed chore(docker)/fix(deps) for exactly that
      // reason. Rules here come after the preset's, so they win.
      matchPackageNames: ['*'],
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
    },
    {
      // Dockerfile updates keep the build(docker) prefix Dependabot used.
      matchManagers: ['dockerfile'],
      semanticCommitScope: 'docker',
    },
    {
      // The reason this file exists: judge Node majors by Node's release
      // schedule, not semver. See the header comment.
      matchDatasources: ['docker'],
      matchPackageNames: ['node'],
      versioning: 'node',
    },
    {
      // One source of truth for the Node that builds the SPA: .node-version
      // (read by every setup-node step via node-version-file, and by fnm,
      // nodenv and n) and the Dockerfile's node base, which cannot read a
      // file, so the group is what keeps the two in step — one PR moves
      // both. Both datasources are LTS-aware. Never automerged: a Node
      // major is a decision.
      //
      // No age floor here, deliberately. Both values are major *lines* —
      // `.node-version` says 22 and the tag is 22-alpine — resolved to the
      // newest patch at install time, so a floor on the line number gates
      // nothing real; the bytes are pinned by the digest, which the floor
      // never covered. What gates a Node major is LTS status, above. And a
      // floor would actively harm this group: when one member is held
      // pending and the other is not, Renovate ships the branch without
      // the pending one ("removing pending upgrades" in the dry run) —
      // the file would move and the image would not, which is the drift
      // this group exists to prevent.
      groupName: 'node toolchain',
      matchDatasources: ['docker', 'node-version'],
      matchPackageNames: ['node'],
      minimumReleaseAge: null,
    },
    {
      // Where the Go toolchain actually advances. go.mod's bare `go 1.24`
      // directive is a floor, not a pin — Renovate's go-mod-directive
      // versioning reads it as ">= 1.24", already satisfied, and correctly
      // never bumps it (confirmed in the adoption dry run). Two pins move
      // here instead, in one group so they stay in step: the Dockerfile's
      // golang base, which decides what compiles the shipped binary, and
      // go.mod's `toolchain` directive (depName `go`), which decides what CI
      // runs — setup-go's go-version-file reads it in preference to the
      // floor. Keeping them grouped is what stops the lint/test toolchain
      // trailing the shipped one, the drift behind #1487's permanently red
      // golangci-lint bump. Automerged under the Go 1 compatibility promise,
      // and not blindly: both required Docker-build jobs compile the whole
      // module with the new toolchain before the merge, and a toolchain the
      // pinned golangci-lint cannot parse fails the required Lint check and
      // waits for a human.
      groupName: 'go toolchain',
      matchDatasources: ['docker', 'golang-version'],
      matchPackageNames: ['golang', 'go'],
      automerge: true,
    },
    {
      // Routine digest advances (the job Dependabot used to do): one PR, one
      // CI run. Content-free to review — the version is unchanged by
      // definition — so it automerges once every required check is green.
      matchUpdateTypes: ['digest'],
      groupName: 'base-image digests',
      automerge: true,
    },
    {
      // Athena's engine image (docker/athena-engine/Dockerfile) moves to a
      // new Trino release together with its plugin zips' URLs and checksums,
      // which no manager here reads — a version bump alone would fail the
      // build. Digest advances of the pinned release still flow (above).
      matchManagers: ['dockerfile'],
      matchPackageNames: ['trinodb/trino-core'],
      matchUpdateTypes: ['major', 'minor', 'patch'],
      enabled: false,
    },
    {
      // The engine image pinned by the config.go custom manager moves only
      // after .github/workflows/athena-engine-image.yml has published a new
      // build, having run the engine's integration tests on it first. Its own
      // PR, never automerged: the pin decides what every user's queries run
      // on, the main test run never starts the engine, and the PR edits Go
      // source, so the changelog check asks its reviewer for a fragment. A
      // new Trino release also moves the tag and sizes the docs quote
      // (RELEASE.md says where), which the reviewer updates by hand.
      //
      // No age floor: the image is ours, published only after the release
      // environment's approval, and GHCR may give no release timestamp, which
      // would hold a version update pending indefinitely (see
      // minimumReleaseAge above).
      matchPackageNames: ['ghcr.io/overcast-sh/overcast-athena-engine'],
      groupName: 'athena engine image',
      automerge: false,
      minimumReleaseAge: null,
    },
    {
      // Non-major Go deps automerge once every required check is green: the
      // full test matrix, lint, the compat suites and both image builds run
      // on the updated modules (scripts/ci-scope.py counts go.mod/go.sum as
      // code, so nothing is skipped). Majors are excluded here by
      // construction and wait for review.
      matchManagers: ['gomod'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'go dependencies (non-major)',
      automerge: true,
    },
    {
      // Confines `lockFileMaintenance` above to the npm workspace. See the
      // comment there for why go.sum is not the same problem.
      matchManagers: ['gomod'],
      matchUpdateTypes: ['lockFileMaintenance'],
      enabled: false,
    },
    {
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'web dependencies (non-major)',
    },
    {
      // The two oxlint packages are peer-locked to each other: oxlint pins
      // `oxlint-tsgolint: >=…`, and both are exact-pinned in web/package.json
      // for the same reason. Splitting a bump across PRs would land a broken
      // peer set, so group them across every update type — majors included,
      // which the 'web dependencies (non-major)' group above does not cover.
      // Reviewed, not automerged: an oxlint bump is a lint-rule bump, and
      // web/.oxlintrc.json is the entire lint gate now (#1330).
      matchManagers: ['npm'],
      matchPackageNames: ['oxlint', 'oxlint-tsgolint'],
      groupName: 'oxlint',
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'github actions (non-major)',
    },
    {
      // The Makefile tool pins, non-major. Reviewed rather than automerged:
      // a linter bump can surface new findings, and the Lint job is the
      // place to read them.
      matchManagers: ['custom.regex'],
      matchFileNames: ['Makefile'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'makefile tool pins (non-major)',
    },
    {
      // actionlint is pinned twice — the Makefile (go run) and the
      // rhysd/actionlint action in test.yml — and the two must agree, so
      // the package name groups them across both managers into one PR.
      matchPackageNames: ['rhysd/actionlint'],
      groupName: 'actionlint',
    },
  ],
}
