coverage.out
coverage.html

# git worktrees
.worktrees/

# compiled binaries
bin/
# stray root-level binaries from `go build ./cmd/...` without -o
/overcast
/overcastd
/capgen
/stub-report
# any stray root-level .exe (ad-hoc Windows cross-compile tests, etc.) — this
# also covers the .exe forms of the binaries listed above.
/*.exe
# The in-container Lambda init (`make lambda-init` / `task lambda-init`), which
# internal/services/lambda/initbin embeds. Build output, exactly like web/dist,
# so it is not committed — the committed dist/.gitkeep beside it is what keeps
# `//go:embed all:dist` resolving in a bare checkout. See AGENTS.md.
internal/services/lambda/initbin/dist/lambda-init-linux-*
# The compressed aws-sdk shape tables internal/awsshapes embeds, built from the
# committed internal/awsshapes/tables by `make aws-sdk-shapes`. Build output, so
# not committed; dist/.gitkeep keeps `//go:embed all:dist` resolving.
internal/awsshapes/dist/*.gz

# go test binaries (from `go test -c`) and profiler outputs
*.test
*.prof
*.pprof
*.trace

# air hot-reload output
tmp/

# persistent state (dev container data dir — survives rebuilds, not for VCS)
.overcast/
# Per-machine tool state that some environments spill into the repo root
# instead of $HOME: Go telemetry counters under .config/go/telemetry (scoped
# per Go version, arch and week) and buildx node refs plus a token seed under
# .docker. Both are machine-local and regenerated on demand — never useful to
# another checkout, so ignore them wherever they come from.
/.config/
/.docker/
# git worktrees (must live outside the repo; ignore any stray ones inside)
.worktrees/
.devcontainer/.env
.devcontainer/docker-compose.yaml

# compat dashboard — last run results (persisted across server restarts, not for VCS)
compat-results.json
# compat agent-friendly text report (regenerated after every run, not for VCS)
compat-report.txt

# There is deliberately no entry here for a docs nav/search index. Both used to
# be generated into the tree and committed (web/src/docs-nav.gen.ts,
# internal/docssearch/index.gen.jsonl); both are gone. Neither ignoring them nor
# committing them is right for a sorted one-entry-per-page manifest — committed
# it conflicts whenever one branch adds a page and another edits its neighbour,
# ignored it has to be generated in every build path including a Node-only SPA
# stage. The console derives both from the docs the binary already embeds, at
# runtime. See internal/docsindex.

# Web console screenshots captured for PR review. They belong on a throwaway
# assets/<branch> branch referenced from the PR body, never in the repo tree —
# see .agents/skills/pull-request/SKILL.md § Hosting.
screenshots/

# log files
*.log
logs.txt

# node_modules (root-level catch-all for any suites without their own .gitignore)
**/node_modules/

# mkcert TLS certificates (generated by vite-plugin-mkcert for HTTPS dev server)
.cert/

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

.cache
/.codex-go-cache/
.npm
.claude/launch.json
# Per-user Claude Code settings: permission grants, env overrides and enabled
# MCP servers are specific to one machine and one person. Shared project
# settings (the PreToolUse hooks) live in .claude/settings.json, which is
# tracked. This one was committed in the initial commit, before Claude Code
# began adding it here on creation, and accumulated local state over four
# commits before it was untracked.
.claude/settings.local.json

# Python bytecode from the helper scripts in scripts/ and the python-sdk suite.
__pycache__/
*.py[cod]

# Compat report renderings — regenerated by scripts/compat-report.py.
compat-junit.xml
compat-comment.md

# Flake detection findings — regenerated by scripts/compat-flake-detect.py.
flake-findings.json
flake-run-*.json
scripts/seed*.*
.pnpm-store/
