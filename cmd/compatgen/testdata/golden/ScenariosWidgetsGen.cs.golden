    private Task TestWidgetsGenSprocketCreateSprocket(TestContext t) => GroupWidgetsGenSprocket.RunTestAsync(t, "CreateSprocket", new ScenarioTest
    {
        Call = new ScenarioCall
        {
            Op = "CreateSprocket",
            Params = "{\"Description\":{\"$ref\":\"gauge.arn\"},\"Name\":{\"$name\":\"s\"}}",
            Build = b =>
            {
                var request = new CreateSprocketRequest();
                request.Description = b.Bind<string>("Description", Val.Ref("gauge.arn"));
                request.Name = b.Bind<string>("Name", Val.Name("s"));
                return request;
            },
            SendAsync = async request =>
                await Cl().CreateSprocketAsync((CreateSprocketRequest)request),
            Export = new()
            {
                ["sprocket.id"] = "$.SprocketId",
            },
        },
        Assert =
        [
            Clause.ResponseField(
                Check.Matches("$.SprocketId", "^s-[0-9a-f]{8}$")
            ),
            Clause.Eventually(3, 100,
                Clause.Readback(
                    new ScenarioCall
                    {
                        Op = "GetSprocket",
                        Params = "{\"SprocketId\":{\"$ref\":\"sprocket.id\"}}",
                        Build = b =>
                        {
                            var request = new GetSprocketRequest();
                            request.SprocketId = b.Bind<string>("SprocketId", Val.Ref("sprocket.id"));
                            return request;
                        },
                        SendAsync = async request =>
                            await Cl().GetSprocketAsync((GetSprocketRequest)request),
                    },
                    Check.EqualTo("$.Sprocket.Description", Val.Ref("gauge.arn"))
                )
            )
        ],
    });

