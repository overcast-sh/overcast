                                Check.equalTo("$.Sprocket.SprocketId", Values.ref("sprocket.id"))
                        )
                ));
    }

    private void testWidgetsGenSprocketTagSprocket(TestContext t) {
        GROUP_WIDGETS_GEN_SPROCKET.runTest(t, "TagSprocket",
                new Call("TagSprocket", "{\"SprocketId\":{\"$ref\":\"sprocket.id\"},\"Tags\":[{\"Key\":\"compat\",\"Value\":\"scenario\"}]}",
                        b -> TagSprocketRequest.builder()
                                .sprocketId(b.string("SprocketId", Values.ref("sprocket.id")))
                                .tags(List.of(SprocketTag.builder().key("compat").value("scenario").build()))
                                .build(),
                        r -> cl().tagSprocket((TagSprocketRequest) r)),
                List.of(
                        Clause.eventually(3, 100,
                                Clause.listContains(
                                        new Call("ListSprocketTags", "{\"SprocketId\":{\"$ref\":\"sprocket.id\"}}",
                                                b -> ListSprocketTagsRequest.builder()
                                                        .sprocketId(b.string("SprocketId", Values.ref("sprocket.id")))
                                                        .build(),
                                                r -> cl().listSprocketTags((ListSprocketTagsRequest) r)),
                                        "$.Tags",
                                        Where.of("$.Key", "compat"),
                                        Where.of("$.Value", "scenario")
                                ))
                ));
    }

    private void testWidgetsGenSprocketListSprocketTags(TestContext t) {
        GROUP_WIDGETS_GEN_SPROCKET.runTest(t, "ListSprocketTags",
                new Call("ListSprocketTags", "{\"SprocketId\":{\"$ref\":\"sprocket.id\"}}",
                        b -> ListSprocketTagsRequest.builder()
                                .sprocketId(b.string("SprocketId", Values.ref("sprocket.id")))
                                .build(),
                        r -> cl().listSprocketTags((ListSprocketTagsRequest) r)),
                List.of(
                        Clause.listContains(
                                null,
                                "$.Tags",
                                Where.of("$.Key", "compat"),
                                Where.of("$.Value", "scenario")
                        )
                ));
    }

    private void testWidgetsGenSprocketUntagSprocket(TestContext t) {
        GROUP_WIDGETS_GEN_SPROCKET.runTest(t, "UntagSprocket",
                new Call("UntagSprocket", "{\"SprocketId\":{\"$ref\":\"sprocket.id\"},\"TagKeys\":[\"compat\"]}",
                        b -> UntagSprocketRequest.builder()
                                .sprocketId(b.string("SprocketId", Values.ref("sprocket.id")))
                                .tagKeys(List.of("compat"))
                                .build(),
                        r -> cl().untagSprocket((UntagSprocketRequest) r)),
                List.of(
                        Clause.eventually(3, 100,
                                Clause.absentFromList(
                                        new Call("ListSprocketTags", "{\"SprocketId\":{\"$ref\":\"sprocket.id\"}}",
                                                b -> ListSprocketTagsRequest.builder()
                                                        .sprocketId(b.string("SprocketId", Values.ref("sprocket.id")))
                                                        .build(),
                                                r -> cl().listSprocketTags((ListSprocketTagsRequest) r)),
                                        "$.Tags",
                                        Where.of("$.Key", "compat")
                                ))
                ));
    }

    private void testWidgetsGenSprocketDeleteSprocket(TestContext t) {
        GROUP_WIDGETS_GEN_SPROCKET.runTest(t, "DeleteSprocket",
                new Call("DeleteSprocket", "{\"SprocketId\":{\"$ref\":\"sprocket.id\"}}",
                        b -> DeleteSprocketRequest.builder()
                                .sprocketId(b.string("SprocketId", Values.ref("sprocket.id")))
                                .build(),
                        r -> cl().deleteSprocket((DeleteSprocketRequest) r)),
                List.of(
                        Clause.eventually(3, 100,
                                Clause.absentByError(
                                        new Call("GetSprocket", "{\"SprocketId\":{\"$ref\":\"sprocket.id\"}}",
                                                b -> GetSprocketRequest.builder()
                                                        .sprocketId(b.string("SprocketId", Values.ref("sprocket.id")))
                                                        .build(),
                                                r -> cl().getSprocket((GetSprocketRequest) r)),
                                        ErrorSpec.of("SprocketNotFound", "SprocketNotFound")))
                ));
    }

