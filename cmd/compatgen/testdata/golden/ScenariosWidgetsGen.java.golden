                new Call("DescribeGauge", "{}",
                        b -> DescribeGaugeRequest.builder()
                                .build(),
                        r -> cl().describeGauge((DescribeGaugeRequest) r))
                        .export("gauge.arn", "$.Gauge.Arn")
                        .export("gauge.id", "$.Gauge.GaugeId"));
    }

    private void teardownWidgetsGenSprocket(TestContext t) {
        GROUP_WIDGETS_GEN_SPROCKET.runTeardown(t,
                new Call("DeleteSprocket", "{\"SprocketId\":{\"$ref\":\"sprocket.id\"}}",
                        b -> DeleteSprocketRequest.builder()
                                .sprocketId(b.string("SprocketId", Values.ref("sprocket.id")))
                                .build(),
                        r -> cl().deleteSprocket((DeleteSprocketRequest) r)));
    }

    private void testWidgetsGenSprocketCreateSprocket(TestContext t) {
        GROUP_WIDGETS_GEN_SPROCKET.runTest(t, "CreateSprocket",
                new Call("CreateSprocket", "{\"Description\":{\"$ref\":\"gauge.arn\"},\"Name\":{\"$name\":\"s\"}}",
                        b -> CreateSprocketRequest.builder()
                                .description(b.string("Description", Values.ref("gauge.arn")))
                                .name(b.string("Name", Values.name("s")))
                                .build(),
                        r -> cl().createSprocket((CreateSprocketRequest) r))
                        .export("sprocket.id", "$.SprocketId"),
                List.of(
                        Clause.responseField(
                                Check.matches("$.SprocketId", "^s-[0-9a-f]{8}$")
                        ),
                        Clause.eventually(3, 100,
                                Clause.readback(
                                        new Call("GetSprocket", "{\"SprocketId\":{\"$ref\":\"sprocket.id\"}}",
                                                b -> GetSprocketRequest.builder()
                                                        .sprocketId(b.string("SprocketId", Values.ref("sprocket.id")))
                                                        .build(),
                                                r -> cl().getSprocket((GetSprocketRequest) r)),
                                        Check.equalTo("$.Sprocket.Description", Values.ref("gauge.arn"))
                                ))
                ));
    }

    private void testWidgetsGenSprocketGetSprocket(TestContext t) {
        GROUP_WIDGETS_GEN_SPROCKET.runTest(t, "GetSprocket",
                new Call("GetSprocket", "{\"SprocketId\":{\"$ref\":\"sprocket.id\"}}",
                        b -> GetSprocketRequest.builder()
