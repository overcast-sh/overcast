fn test_widgets_gen_widget_create_widget(client: &aws_sdk_widgets::Client) -> Test {
    Test {
        call: Call {
            op: "CreateWidget",
            params: scenario::map(vec![
                ("Color", scenario::lit(::serde_json::json!("blue"))),
                ("Description", scenario::lit(::serde_json::json!("one"))),
                ("Name", scenario::name("w")),
            ]),
            export: vec![
                ("widget.arn", "$.Arn"),
                ("widget.id", "$.WidgetId"),
            ],
            invoke: {
                let client = client.clone();
                scenario::invoker(move |b| {
                    let client = client.clone();
                    Box::pin(async move {
                        let capture = scenario::Capture::new();
                        let request = client
                            .create_widget()
                            .color(aws_sdk_widgets::types::Color::from("blue"))
                            .description("one")
                            .name(b.string("Name")?)
                            .customize()
                            .interceptor(capture.clone());
                        Ok(scenario::observe(request.send().await, &capture))
                    })
                })
            },
        },
        assert: vec![
            scenario::response_field(vec![
                scenario::non_empty("$.Arn"),
                scenario::matches("$.WidgetId", "^w-[0-9a-f]{8}$"),
            ]),
            scenario::readback(
                Call {
                    op: "GetWidget",
                    params: scenario::map(vec![
                        ("WidgetId", scenario::context("widget.id")),
                    ]),
                    export: Vec::new(),
                    invoke: {
                        let client = client.clone();
                        scenario::invoker(move |b| {
                            let client = client.clone();
                            Box::pin(async move {
                                let capture = scenario::Capture::new();
                                let request = client
                                    .get_widget()
                                    .widget_id(b.string("WidgetId")?)
                                    .customize()
                                    .interceptor(capture.clone());
                                Ok(scenario::observe(request.send().await, &capture))
                            })
                        })
                    },
                },
                vec![
                    scenario::equals("$.Widget.Description", scenario::lit(::serde_json::json!("one"))),
                    scenario::equals("$.Widget.WidgetId", scenario::context("widget.id")),
                ],
            ),
            scenario::list_contains(
                Some(Call {
                    op: "ListWidgets",
                    params: scenario::map(vec![("NamePrefix", scenario::name("w"))]),
                    export: Vec::new(),
                    invoke: {
                        let client = client.clone();
                        scenario::invoker(move |b| {
                            let client = client.clone();
                            Box::pin(async move {
                                let capture = scenario::Capture::new();
                                let request = client
                                    .list_widgets()
                                    .name_prefix(b.string("NamePrefix")?)
                                    .customize()
                                    .interceptor(capture.clone());
                                Ok(scenario::observe(request.send().await, &capture))
                            })
                        })
                    },
                }),
                "$.Widgets",
                vec![
                    scenario::where_entry("$.WidgetId", scenario::context("widget.id")),
                ],
            ),
        ],
    }
}

