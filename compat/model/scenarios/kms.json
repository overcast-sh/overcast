              }
            },
            {
              "kind": "eventually",
              "maxAttempts": 6,
              "delayMs": 500,
              "assert": {
                "kind": "readback",
                "call": {
                  "op": "DescribeKey",
                  "params": {
                    "KeyId": {
                      "$ref": "key.id"
