            "op": "CreateKey",
            "params": {
              "Description": "compat-scenario key, initial description",
              "KeySpec": "SYMMETRIC_DEFAULT",
              "KeyUsage": "ENCRYPT_DECRYPT"
            },
            "export": {
              "key.arn": "$.KeyMetadata.Arn",
              "key.id": "$.KeyMetadata.KeyId"
            }
          },
          "assert": [
            {
              "kind": "responseField",
