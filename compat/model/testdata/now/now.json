    { "name": "one-ahead", "now": { "unit": "epochMillis", "offsetMillis": 1 }, "value": 1726000000124 },
    { "name": "an-hour-behind", "now": { "unit": "epochMillis", "offsetMillis": -3600000 }, "value": 1725996400123 },
